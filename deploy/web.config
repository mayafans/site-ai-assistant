<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 反向代理示例（放在业务站点根目录；需安装 ARR + URL Rewrite）
  作用：/ai/* → 127.0.0.1:8820 的 Node 助手服务；同源，免 CORS
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ai-widget" stopProcessing="true">
          <match url="^ai/widget\.js$" />
          <action type="Rewrite" url="http://127.0.0.1:8820/widget.js" />
        </rule>
        <rule name="ai-widget-esm" stopProcessing="true">
          <match url="^ai/widget\.esm\.js$" />
          <action type="Rewrite" url="http://127.0.0.1:8820/widget.esm.js" />
        </rule>
        <rule name="ai-api" stopProcessing="true">
          <match url="^ai/api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8820/api/{R:1}" />
        </rule>
        <rule name="ai-admin" stopProcessing="true">
          <match url="^ai/admin$" />
          <conditions>
            <add input="{REMOTE_ADDR}" pattern="^10\.|^192\.168\.|^127\." />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8820/admin" />
        </rule>
      </rules>
      <outboundRules>
        <!-- SSE 关闭压缩/缓冲，避免代理攒包导致“半天不出字” -->
        <rule name="no-buffer-sse" preCondition="isSse">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-store" />
        </rule>
        <preConditions>
          <preCondition name="isSse">
            <add input="{RESPONSE_Content-Type}" pattern="text/event-stream" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <!-- 按需启用 CSP；把域名换成你的正式域名 -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' data: https:;" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
